{
  "name": "@jackice/pi-ui",
  "version": "0.5.0",
  "description": "Terminal UI components for Pi extensions: theme mapping, ANSI-safe layout, panels, status lines, segment bars, gauges, diff frames, Edit/TODO/Approval views.",
  "type": "module",
  "license": "MIT",
  "author": "jackice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackice/pi-ui.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "import": "./dist/diff/index.js"
    },
    "./views/edit": {
      "types": "./dist/views/edit.d.ts",
      "import": "./dist/views/edit.js"
    },
    "./views/todo": {
      "types": "./dist/views/todo.d.ts",
      "import": "./dist/views/todo.js"
    },
    "./views/approval": {
      "types": "./dist/views/approval.d.ts",
      "import": "./dist/views/approval.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "tsx examples/gallery.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:startup": "node scripts/startup-bench.mjs",
    "bench:heap": "node --expose-gc scripts/heap-bench.mjs",
    "bench:coldstart": "node scripts/coldstart-bench.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "^1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
